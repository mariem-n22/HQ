// Mariem N. Elsbelgy — consolidated data model (v6 PART 3).
//
// Field names follow the brief. Three fields marked "kept from the live
// schema" are not in the brief's list but are read by shipped UI, and PART 5
// requires the migrated UI to be bit-for-bit identical — dropping them would
// visibly break the contact page and the portfolio header. They are called out
// individually below.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here — the connection string lives in
// prisma.config.ts for the CLI, and reaches PrismaClient through the pg
// driver adapter in lib/prisma.ts.
datasource db {
  provider = "postgresql"
}

/// Architecture project lifecycle. Replaces the software lifecycle
/// (BUILDING/SHIPPED/ARCHIVED) the site carried when it was a dev portfolio.
enum ProjectStatus {
  CONCEPT
  UNDER_CONSTRUCTION
  COMPLETED
  COMPETITION
  UNBUILT
}

/// Project typology. The /work filter bar is built from the values actually
/// present in the data, not from this list, so adding a member here does not
/// put an empty filter chip on the page.
enum Typology {
  RESIDENTIAL
  HOSPITALITY
  CULTURAL
  COMMERCIAL
  INSTITUTIONAL
  URBAN
  INTERIORS
  LANDSCAPE
}

/// Which section of the project page a media item belongs to. This is the
/// replacement for the single flat `images[]` bucket: the detail template
/// pulls each section straight from its category instead of every image
/// landing in one gallery.
enum MediaCategory {
  HERO
  GALLERY
  PLAN
  SECTION
  ELEVATION
  DIAGRAM
  MATERIAL
  CONSTRUCTION
  SITE
}

enum MediaKind {
  IMAGE
  VIDEO
}

/// The single owner account. No sign-up route exists; this row is created by
/// prisma/seed.ts from ADMIN_EMAIL / ADMIN_PASSWORD.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Mariem")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  tagline     String        @default("")
  description String        @default("")
  /// What actually came of the project — results, impact, what happened next.
  /// Optional; the detail page hides the section entirely when empty.
  outcome     String        @default("")
  role        String        @default("")
  /// Client or employer the project was built for, when there was one.
  company     String        @default("")
  location    String        @default("")
  /// Full timeframe for the detail page ("Jul 2024 — Nov 2024"). `year` stays
  /// as the compact badge the cards render.
  period      String        @default("")
  stack       String[]      @default([])
  links       Json          @default("{}")
  status      ProjectStatus @default(CONCEPT)
  year        String        @default("")
  emoji       String        @default("")
  coverImage  String?
  featured    Boolean       @default(false)
  /// Legacy name for the portfolio flag; kept so existing data maps 1:1.
  showOnResume   Boolean @default(false)
  /// The brief's explicit name for the same idea. The migration script copies
  /// showOnResume into it so both agree; the UI reads showOnPortfolio.
  showOnPortfolio Boolean @default(false)
  order       Int           @default(0)

  // ---------------------------------------------------------------------
  // Architecture case-study fields.
  //
  // Everything below is optional by design: the detail template renders a
  // section only when its data exists, so a half-filled project degrades to
  // a shorter page rather than a page full of empty "Client: —" rows.
  // ---------------------------------------------------------------------

  /// Typology — drives the /work filter.
  typology       Typology?
  /// Gross floor area, free text so the studio controls the unit ("2,400 m²").
  area           String    @default("")
  /// The commissioning client. Distinct from the legacy `company` field.
  client         String    @default("")
  collaborators  String[]  @default([])

  /// Editorial paragraph on concept and intent — why the building exists.
  statement      String    @default("")

  /// Context / site.
  siteDescription String   @default("")
  orientation     String   @default("")
  climate         String   @default("")

  /// Technical layer. Optional per project; a handful of flagship projects
  /// use it, most leave it blank and the whole section disappears.
  structuralConcept     String @default("")
  environmentalStrategy String @default("")
  lightingConcept       String @default("")
  constructionDetail    String @default("")

  /// Timeline stages, one per entry, written "Label — Year".
  stages         String[]  @default([])
  /// Awards or press, one per entry. Deliberately not a relation: the
  /// site-wide Awards/Press system is out of scope, this is just a line.
  recognition    String[]  @default([])

  /// Long-form hero video (Vimeo/YouTube). Short self-hosted loops go through
  /// ProjectMedia with kind = VIDEO instead.
  heroEmbedUrl   String    @default("")

  images      ProjectImage[]
  media       ProjectMedia[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([order])
}

/// Replaces the old `projects.gallery` jsonb column.
/// Categorised project media. One row per asset, ordered within its category.
///
/// `width`/`height` are captured at upload so galleries and the hero can lay
/// out landscape, portrait and panoramic shots without blind center-cropping
/// — architecture photography is frequently wide, and the old flat model had
/// no dimension data at all.
model ProjectMedia {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  MediaCategory
  kind      MediaKind     @default(IMAGE)
  /// Self-hosted asset URL (Vercel Blob). Empty when `embedUrl` is used.
  url       String        @default("")
  /// Vimeo/YouTube URL for long-form video.
  embedUrl  String        @default("")
  /// Material name, diagram step label, drawing title.
  label     String        @default("")
  caption   String        @default("")
  alt       String        @default("")
  width     Int?
  height    Int?
  order     Int           @default(0)

  @@index([projectId, category, order])
}

/// Legacy flat gallery. Superseded by ProjectMedia and no longer written to
/// or rendered; kept so nothing that still reads the relation breaks.
model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  caption   String  @default("")
  alt       String  @default("")
  order     Int     @default(0)

  @@index([projectId, order])
}

model Skill {
  id       String @id @default(cuid())
  category String
  name     String
  /// 0-100 percentage scale.
  level    Int    @default(0)
  /// simple-icons style slug resolved by src/lib/skill-icons.ts.
  icon     String @default("")
  /// Kept from the live schema: an uploaded logo URL for anything the icon
  /// library has no mark for. Falls back to `icon` when empty.
  iconImage String?
  order    Int    @default(0)

  @@index([order])
}

model Experience {
  id           String   @id @default(cuid())
  org          String
  role         String
  period       String   @default("")
  location     String?
  /// Short — rendered on the condensed timeline card.
  summary      String   @default("")
  /// Full — rendered only inside the popup.
  description  String   @default("")
  achievements String[] @default([])
  stack        String[] @default([])
  image        String?
  order        Int      @default(0)

  @@index([order])
}

model ContentBlock {
  id    String @id @default(cuid())
  key   String @unique
  title String @default("")
  body  String @default("")
}

model IdentityMoment {
  id          String  @id @default(cuid())
  year        String  @default("")
  title       String
  /// Free-text grouping. The public filter is built from the values actually
  /// in use, so a new category needs no schema or code change — type it once
  /// on a moment and it appears as a filter.
  category    String  @default("")
  /// Short — rendered on the card. Live column is `teaser`, and the shipped
  /// component reads `summary`; the migration reconciles them onto this field.
  teaser      String  @default("")
  description String  @default("")
  image       String?
  order       Int     @default(0)

  @@index([order])
}

model Venture {
  id           String  @id @default(cuid())
  name         String
  description  String  @default("")
  jurisdiction String?
  status       String  @default("Exploring")
  image        String?
  order        Int     @default(0)

  @@index([order])
}

model MiscEntry {
  id          String  @id @default(cuid())
  title       String
  description String  @default("")
  emoji       String  @default("")
  image       String?
  order       Int     @default(0)

  @@index([order])
}

model NowEntry {
  id     String   @id @default(cuid())
  /// The line shown on the card. Kept short; `details` carries the rest.
  text   String
  /// Long form, shown only in the popup. Optional — an entry with none simply
  /// does not open, so a card never promises detail it does not have.
  details String  @default("")
  active Boolean  @default(true)
  /// Genuinely optional — a Now update is text-first, so no placeholder is
  /// rendered when this is null.
  image  String?
  date   DateTime @default(now())

  @@index([date])
}

/// Which of an achievement's two photo sets a media row belongs to.
///
/// A competition entry produces two genuinely different bodies of imagery:
/// the submitted work, and the event it was submitted to. They are shot in
/// different places on different days and read as separate sets, so they are
/// modelled as separate galleries rather than one merged pile.
enum AchievementMediaSet {
  WORK
  EVENT
}

model AchievementMedia {
  id            String              @id @default(cuid())
  achievementId String
  achievement   Achievement         @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  set           AchievementMediaSet
  url           String              @default("")
  caption       String              @default("")
  alt           String              @default("")
  width         Int?
  height        Int?
  order         Int                 @default(0)

  @@index([achievementId, set, order])
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  /// URL segment for /achievements/<slug>. Sanitised on every save through the
  /// same slugify the project slug uses, so a title with spaces or commas can
  /// never produce an unreachable page.
  slug        String   @unique @default("")
  role        String   @default("")
  category    String   @default("")
  date        String   @default("")
  location    String   @default("")
  description String   @default("")
  image       String?
  tags        String[] @default([])
  order       Int      @default(0)
  media       AchievementMedia[]

  @@index([order])
}

enum BookStatus {
  READING
  FINISHED
}

/// What kind of book it is, which is orthogonal to how far through it is.
///
/// Deliberately an enum rather than free text, matching every other classifier
/// in this schema (ProjectStatus, Typology, MediaCategory). Only the two values
/// that exist in practice today — a third goes in when a real third category
/// turns up, not before.
enum BookCategory {
  GENERAL
  CODES_AND_STANDARDS
}

/// A reading log entry — what he pulled out of a book, not a summary of it.
model Book {
  id         String     @id @default(cuid())
  title      String
  /// Country of origin or publication.
  ///
  /// This field was `author` until the shelf was repurposed for an architecture
  /// practice, where the useful fact about a code or standard is which
  /// jurisdiction it belongs to. Renamed rather than added alongside: there is
  /// no reason to carry both, and the single row that existed held a leftover
  /// software title with its own name repeated in the author field, so nothing
  /// was migrated across.
  country    String     @default("")
  category   BookCategory @default(GENERAL)
  coverImage String?
  /// Standout lines worth quoting. Rendered as pulled quotes, not prose.
  highlights String[]   @default([])
  /// What he actually got from it / how it changed his thinking.
  takeaway   String     @default("")
  status     BookStatus @default(FINISHED)
  order      Int        @default(0)

  @@index([order])
}

/// A credential, with the certificate image and a link to verify it.
model Certification {
  id        String  @id @default(cuid())
  title     String
  issuer    String  @default("")
  image     String?
  /// Verification / credential page. Optional.
  sourceUrl String  @default("")
  date      String  @default("")
  order     Int     @default(0)

  @@index([order])
}

/// Portrait/hero images for the /portfolio hero slot. Modelled on
/// ProjectImage so ordering and the dashboard manager work identically.
model HeroImage {
  id      String @id @default(cuid())
  url     String
  caption String @default("")
  alt     String @default("")
  order   Int    @default(0)

  @@index([order])
}

/// Singleton — enforced by always reading/writing id = "singleton".
model SiteSettings {
  id                    String  @id @default("singleton")

  /// Home page hero.
  ///
  /// Deliberately its own field rather than reusing `heroImage` or the
  /// HeroImage gallery: those feed the portfolio page, and the home hero is a
  /// single asset that should be swappable without disturbing them. Accepts an
  /// image or a video — the kind is inferred from the file extension, so the
  /// operator uploads one file and does not have to declare which it is.
  homeHeroUrl           String?
  /// Credit line shown small in the hero corner. Required for any image whose
  /// licence asks for attribution — a CC BY-SA photograph published without it
  /// is a licence breach — and useful anyway once real photography lands, since
  /// architectural photographers are credited by convention.
  homeHeroCredit        String  @default("")
  /// The signature line over the hero. Left blank until the studio supplies a
  /// real statement; the page shows an obvious placeholder rather than any
  /// invented copy.
  signatureStatement    String  @default("")
  /// Location tags, e.g. ["Cairo", "Egypt"] or ["Cairo", "London", "Dubai"].
  /// A list, so more cities need no code change.
  locations             String[] @default([])
  /// The Signature Statement section, directly beneath the hero.
  statementHeadline     String  @default("")
  statementBody         String  @default("")

  /// "The Practice" — a home-page-only block, with no page behind it.
  ///
  /// Deliberately static fields rather than a new content model or a
  /// /studio/practice route. Nothing in the project describes how the studio
  /// works, and an earlier "Explore the Practice" footer link was removed
  /// precisely because it pointed at a page that did not exist. A section that
  /// lives entirely on the home page is the honest shape for a paragraph of
  /// content; it can be promoted to a real page later if it outgrows that.
  practiceHeadline      String  @default("")
  practiceBody          String  @default("")
  /// Scope lines — disciplines, services, the kinds of work taken on. A list
  /// so the section renders as a list rather than a second paragraph block,
  /// which keeps it visually distinct from the Signature Statement above it.
  practiceDisciplines   String[] @default([])
  /// Optional image beside the Practice text. An enhancement, not a gate — the
  /// section still hides unless one of the three text fields above has content,
  /// because a picture on its own is not a description of how the studio works.
  practiceImage         String?

  heroImage             String?
  avatarImage           String?
  openToOpportunities   Boolean @default(true)
  philosophyQuote       String  @default("")
  /// Profile links. ArchDaily and Behance replaced GitHub, which was a
  /// leftover from the site's previous life as a software portfolio and has no
  /// place on an architecture one. Empty until real URLs exist — `channelsOf`
  /// drops any channel with a blank href, so an unfilled profile renders
  /// nothing rather than a dead link.
  archdaily             String  @default("")
  behance               String  @default("")
  linkedin              String  @default("")
  instagram             String  @default("")
  whatsapp              String  @default("")
  phone                 String  @default("")
  email                 String  @default("")
  /// Kept from the live schema — the /contact "Based in" row and the portfolio
  /// header subtitle read this.
  location              String  @default("")
  /// Kept from the live schema — the availability pill on /contact and the
  /// "open to opportunities" badge on /portfolio read this.
  availability          String  @default("")
  /// The current CV. Uploading a new one replaces the file in Blob storage —
  /// there is deliberately no version history.
  cvUrl                 String?
  cvUpdatedAt           DateTime?
  updatedAt             DateTime @updatedAt
}

/// The contact form target. Written anonymously, read only by the admin.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String   @default("")
  message   String
  /// Null until the inbox marks it read.
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// The Architect — a single-row profile page. Modelled as a singleton the way
/// SiteSettings is, so the dashboard edits one record rather than managing a
/// list of one.
/// The About page. A singleton, the way SiteSettings is.
///
/// The biography is broken into named sections rather than held as one block,
/// because a visitor scans this page for specific facts — where they trained,
/// what they have built — and a single wall of prose hides all of them. Every
/// section is optional and the page renders only the ones with content, so a
/// half-written profile reads as a shorter page rather than a skeleton.
model ArchitectProfile {
  id          String @id @default("singleton")
  name        String @default("")
  /// "Architect / Founder" — one or more role lines.
  roleLine    String @default("")
  portrait    String @default("")

  /// Standfirst above the sections. The former single `biography` field; kept
  /// under the same name so nothing already written is orphaned.
  biography   String @default("")

  earlyYears        String @default("")
  education         String @default("")
  career            String @default("")
  foundingPractice  String @default("")
  /// A short excerpt only. The full statement lives on the Philosophy page and
  /// is rendered from that record, so the two can never disagree.
  philosophyNote    String @default("")
  milestones        String @default("")
  currently         String @default("")

  /// Page-scoped lists, written "Name — Year" and "Title — URL". Deliberately
  /// not relations: the site-wide Awards/Press systems are out of scope, and
  /// these are a handful of lines on one page.
  awards       String[] @default([])
  publications String[] @default([])

  /// Education, prior practice, licensure. One per entry, kept to a line or
  /// two total — this is not a formatted resume.
  credentials String[] @default([])
  updatedAt   DateTime @updatedAt
}

/// Philosophy — an intentionally minimal manifesto. One free-text block the
/// studio edits directly; deliberately not over-structured.
model Philosophy {
  id        String   @id @default("singleton")
  /// Pull-quote sized statement of the practice's design position.
  statement String   @default("")
  /// Optional supporting paragraphs beneath the statement.
  body      String   @default("")
  /// Optional image for the home page section. Same rule as Practice: the
  /// statement is what gates the section, this only enriches it.
  image     String?
  updatedAt DateTime @updatedAt
}
