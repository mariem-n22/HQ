# Postgres — Neon or Vercel Postgres. Use the POOLED connection string.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-me"

# Seeding the single admin account (prisma/seed.ts). Only read at seed time;
# re-running the seed resets the password.
ADMIN_EMAIL="mahmoudbmawy2025@gmail.com"
ADMIN_PASSWORD="replace-me-min-8-chars"
ADMIN_NAME="Mahmoud"

# Vercel Blob — dashboard image uploads. Not needed for the data migration
# (the Supabase export contained zero image URLs), only for new uploads.
BLOB_READ_WRITE_TOKEN=""
